# Copy to .env and fill in once Track A shares the Supabase connection string.
# Local default (no .env needed) is a SQLite file: sqlite:///./fusion_backend.db
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# Fusion Layer weights (must sum to 1.0), see PROJECT_PLAN.md Section 4
FUSION_WEIGHT_SPILLOVER=0.4
FUSION_WEIGHT_SENTIMENT_RISK=0.3
FUSION_WEIGHT_CREATOR_FEATURE=0.3
