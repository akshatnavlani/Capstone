# Copy to .env and fill in real values. .env is gitignored — never commit real credentials.

# --- Supabase / Postgres (Track A) ---
# From Supabase project settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# From Supabase project settings > Database > Connection string (use the pooled
# "Transaction" connection string for scripts/serverless; "Session" for long-lived
# migration tools like the Supabase CLI)
DATABASE_URL=

# --- YouTube Data API (Track A ingestion) ---
# From Google Cloud Console > APIs & Services > Credentials > Create API key
# (choose "Public data" when prompted for API vs. OAuth client — we only ever read
# public YouTube content, never act on behalf of a specific signed-in user)
YOUTUBE_API_KEY=

# --- agent-reach (Track A ingestion, Instagram/Reddit) ---
# Only needed if using the rdt-cli (non-OpenCLI) Reddit backend on a headless/server
# environment. OpenCLI reuses your logged-in Chrome session and needs no keys here.
# GROQ_API_KEY= (optional: only if using agent-reach transcribe / Whisper fallback)

# --- OpenCLI (Track A ingestion, Instagram/Reddit) ---
# Required if more than one Chrome/Chromium profile is ever connected to the OpenCLI
# daemon at once (commands become ambiguous otherwise) — run `opencli profile list`
# to find the right value. Real Google Chrome is the confirmed-working browser here;
# Arc (Chromium-based) connects but its commands hang indefinitely — see
# DATA_COLLECTION_STATUS.md before trying a non-Chrome browser again.
OPENCLI_PROFILE=
