# Copy to .env and fill in real values. .env is gitignored — never commit real credentials.

# --- Supabase / Postgres (Track A) ---
# From Supabase project settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# From Supabase project settings > Database > Connection string (use the pooled
# "Transaction" connection string for scripts/serverless; "Session" for long-lived
# migration tools like the Supabase CLI)
DATABASE_URL=

# --- YouTube Data API (Track A ingestion) ---
# From Google Cloud Console > APIs & Services > Credentials
YOUTUBE_API_KEY=

# --- agent-reach (Track A ingestion, Instagram/Reddit) ---
# Only needed if using the rdt-cli (non-OpenCLI) Reddit backend on a headless/server
# environment. OpenCLI reuses your logged-in Chrome session and needs no keys here.
# GROQ_API_KEY= (optional: only if using agent-reach transcribe / Whisper fallback)
